###############################################################################
# Account identity
#
# The account id is DISCOVERED, not pinned. These sandboxes are destroyed and
# reissued with a new account id constantly, and hand-editing this file on every
# reissue is exactly the kind of toil that goes stale and then applies the wrong
# thing to the wrong account.
#
# For a long-lived account, pin it instead:
#
#   export TG_AWS_ACCOUNT_ID=123456789012
#
# Pinning also re-arms the wrong-account guard generated by root.hcl, which is a
# real safety net only when it has something independent to compare against.
###############################################################################

locals {
  account_name = "cloudgeeks"

  pinned_account_id = get_env("TG_AWS_ACCOUNT_ID", "")

  aws_account_id = (
    local.pinned_account_id != ""
    ? local.pinned_account_id
    : run_cmd("--terragrunt-quiet", "aws", "sts", "get-caller-identity", "--query", "Account", "--output", "text")
  )

  account_guard_enabled = local.pinned_account_id != ""

  # Derived, so a new sandbox needs no edit here at all. Terragrunt creates and
  # hardens this bucket on demand - see root.hcl and the deploy docs.
  state_bucket = "cloudgeeks-eks-blueprints-tfstate-${local.aws_account_id}"

  # Customer-managed KMS key for state, OPT-IN:
  #
  #   export TG_STATE_KMS_KEY=alias/terraform-state
  #
  # Left empty, the bucket keeps the SSE-KMS default Terragrunt applies at
  # bootstrap. It is empty by default on purpose: `terragrunt backend bootstrap`
  # creates and hardens the BUCKET but does not create KMS keys, so naming a CMK
  # here that does not exist yet reintroduces the manual pre-step this whole setup
  # exists to remove - and fails with NotFoundException on the alias.
  state_kms_key = get_env("TG_STATE_KMS_KEY", "")
}
