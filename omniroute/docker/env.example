# ──────────────────────────────────────────────────────────────────────────────
#  OmniRoute — local environment
#  Copy to `.env` (which is gitignored), then fill the three required secrets:
#
#    cp env.example .env
#    ./generate-secrets.sh >> .env      # appends JWT_SECRET / API_KEY_SECRET
#
#  Full upstream contract: https://github.com/diegosouzapw/OmniRoute/blob/main/.env.example
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. Required secrets ───────────────────────────────────────────────────────
# Signs dashboard session cookies.        Generate: openssl rand -base64 48
JWT_SECRET=
# Encrypts provider API keys at rest.     Generate: openssl rand -hex 32
API_KEY_SECRET=
# First-boot dashboard password. Hashed to bcrypt on startup, then changeable
# from Dashboard → Settings → Security. CHANGE IT — never leave the upstream
# default of CHANGEME.
INITIAL_PASSWORD=

# ── 2. Optional hardening ─────────────────────────────────────────────────────
# Encrypts the whole SQLite database at rest. Generate: openssl rand -hex 32
# ⚠️ Losing this value makes an existing database unreadable — back it up.
# STORAGE_ENCRYPTION_KEY=

# Require a client API key on /v1/* requests. Upstream default is `false`, which
# means anyone who can reach the port can spend your provider quota. Set to true
# whenever the port is reachable beyond loopback, then create keys in the
# dashboard (Settings → API Keys).
REQUIRE_API_KEY=false

# Shared secret for the WebSocket bridge. Required for any non-local deployment.
# Generate: openssl rand -hex 32
# OMNIROUTE_WS_BRIDGE_SECRET=

# ── 3. URLs and ports ─────────────────────────────────────────────────────────
# Public origin, used for OAuth provider callbacks. Must match how you reach the
# dashboard in the browser, or provider logins redirect to the wrong host.
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Host port for the dashboard + API + MCP (all share one port).
PORT=20128

# Set true only when serving over HTTPS — secure cookies are dropped on plain HTTP.
AUTH_COOKIE_SECURE=false

# ── 4. Optional infrastructure ────────────────────────────────────────────────
# Uncomment together with `docker compose --profile redis up -d`. Left unset,
# OmniRoute logs a notice and uses in-memory rate limiting instead.
# REDIS_URL=redis://redis:6379

# Node heap ceiling in MB. Raise for heavy concurrent streaming.
OMNIROUTE_MEMORY_MB=1024

# Image tag. Pinned rather than `latest` so a rebuild is reproducible.
OMNIROUTE_VERSION=3.8.49

# ── 5. Provider credentials ───────────────────────────────────────────────────
# Not needed here. Providers are added at runtime in the dashboard
# (Providers → Add connection: OAuth, API key, or a free tier), and their
# credentials are stored encrypted in SQLite — not in this file.
