# OPTIONAL. The stack runs without this file — every value below has a working
# default in docker-compose.yaml. Copy to .env only to override them.
#
#   cp .env.example .env
#
# Generate real secrets in one go:
#   printf 'JWT_SECRET=%s\nAPI_KEY_SECRET=%s\nMACHINE_ID_SALT=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" "$(openssl rand -hex 16)" >> .env

# Dashboard login password. Replaces the 123456 default.
# Applied on FIRST start only, against an empty data volume.
# Default: changeme123
INITIAL_PASSWORD=

# Signs dashboard sessions — keeps you logged in across container recreates.
JWT_SECRET=

# HMAC secret used to sign generated API keys. Not a key itself —
# mint those in the dashboard's Endpoints section.
API_KEY_SECRET=

# Salts the derived machine id.
MACHINE_ID_SALT=

# How you reach the dashboard. Must match the browser URL or OAuth callbacks break.
# VPS example: PUBLIC_URL=http://44.198.185.28:8080
# Default: http://localhost:8080
PUBLIC_URL=

# Interface the port is published on.
#   0.0.0.0    reachable from the network (default) — lock the port down in your firewall / security group
#   127.0.0.1  local only; reach it over an SSH tunnel
BIND_ADDR=

# Hermes dashboard login (http://<host>:9119/login).
# Defaults in docker-compose.yaml already work: admin / changeme123.
# DO NOT set these to empty strings — an empty hash stops Hermes from starting
# (it refuses to bind a non-loopback dashboard with no auth), and an empty API
# key stops the API server binding, which fails the healthcheck. Leave the lines
# out entirely, or give them real values.
#
# The hash is scrypt and can ONLY be produced by the Hermes image itself —
# never openssl dgst / python hashlib. See the README.
# Any literal $ in the hash MUST be doubled to $$ or Compose eats it.
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD_HASH=
HERMES_DASHBOARD_SECRET=

# Bearer token for Hermes' own API on :8642. Required for the API to bind at all.
HERMES_API_SERVER_KEY=

# Interface the Hermes API publishes on. Loopback by default: this endpoint runs
# agent work as the container user. Only change it if you know why.
HERMES_API_BIND=127.0.0.1

# HOST ports for Hermes. Container ports stay 8642 / 9119 either way.
# Example: publish the dashboard on 8081 instead.
HERMES_API_HOST_PORT=8642
HERMES_DASHBOARD_HOST_PORT=9119

# Key the Hermes agent uses to call 9Router. Generate it in the dashboard's
# Endpoints section — the compose network is not loopback, so Hermes is a
# "remote" caller and a key is mandatory. Without it Hermes starts but every
# model call comes back: API key required for remote API access.
NINEROUTER_API_KEY=

# Optional: Headroom compression. Used with --profile headroom.
# HEADROOM_URL=http://headroom:8787

# Optional: verbose logging.
# DEBUG=true
