# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
# Anchored to the repo root on purpose. An unanchored `env/` also matches
# aws/terragrunt/env/ — the Terragrunt unit tree — and silently kept every
# terragrunt.hcl out of version control.
/env/

# ── Terraform / Terragrunt ───────────────────────────────────────────────────
# Also declared in aws/.gitignore. Repeated here deliberately: these artifacts are
# state and credentials-adjacent, and a module or unit added outside aws/ must not
# depend on someone remembering to copy the rules. `.terragrunt-cache/` in
# particular holds a GENERATED backend.tf containing the state bucket name.
.terraform/
.terraform.lock.hcl
.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfstate.*.backup
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json

# ── Secrets / local config — never commit real values ────────────────────────
# Anything whose name contains "secret" is excluded, so a rendered Secret picks up
# the rule no matter what it is called (secret.yaml, omniroute-secrets.yaml,
# rendered-secret.yml, …). Templates and examples are re-allowed at the bottom.
*secret*.yaml
*secret*.yml
*secret*.json
secrets/*.yaml
!secrets/*.template.yaml

# Env files. `.env.*` also covers `.env.example`, which is why the shipped templates
# are named `env.example` (no leading dot).
.env
.env.*

# Keys, certs and credential blobs
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json
creds*.json
service-account*.json
sa-key*.json

# Kubeconfigs
kubeconfig
*-kubeconfig
*.kubeconfig

# Re-allow the tracked templates/examples (must stay last to win)
!*.template.yaml
!*.template.yml
!*.example
!*example*.yaml
!env.example

# Logs & runtime
*.lock
.*.lock
.*.pid
*.log
proxy-sessions.json
.claude-code-bridge.log

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
