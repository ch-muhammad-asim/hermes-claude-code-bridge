# Copy to .env (same folder) — run.sh and install.sh source it. All optional.
UPSTREAM_PORT=18386                       # the pi-opencode-cli pure-LLM OpenCode bridge
PI_CLI_MODEL=opencode/mimo-v2.5-free      # default model pi starts with (/model switches)
PI_CLI_GUARDRAILS=0                       # 1 = also load ../common/extensions/guardrails (approval prompts)
OPENCODE_BRIDGE_TIMEOUT=600               # per request, seconds
OPENCODE_BRIDGE_MAX_CONCURRENCY=2         # parallel `opencode run` processes
# OPENCODE_BRIDGE_CWD=                    # where the bridge runs opencode (default $HOME; it has no tools anyway)
# OPENCODE_BIN=/opt/homebrew/bin/opencode
# PI_CLI_LOG=~/.pi-cli-opencode.log

# Read by extensions/opencode-cli (only if you move the bridge or add auth):
# PI_OPENCODE_CLI_UPSTREAM=http://127.0.0.1:18386/v1
# PI_OPENCODE_CLI_API_KEY=
# PI_OPENCODE_CLI_MODELS=                 # comma list; skips /v1/models discovery

# Only used when PI_CLI_GUARDRAILS=1:
# PI_GUARDRAILS_CONFIG=                   # default ../common/guardrails.json
# PI_GUARDRAILS_AUDIT=                    # default ~/.pi-bridge-audit.jsonl
# PI_APPROVAL_NONINTERACTIVE=allow        # headless runs (pi -p) cannot prompt: allow | deny
