# codex backend — copy to .env next to run.sh and edit. install.sh and run.sh both read it.
# (run.sh reads .env too, but ONLY install.sh bakes the port into the generated launchd runner —
#  after changing UPSTREAM_PORT you must re-run ./install.sh, not just restart the service.)

# Port the pure-LLM codex bridge listens on.
UPSTREAM_PORT=18288

# Model passed to `codex exec --model`. Must be one your codex login can use.
PI_CLI_MODEL=gpt-5.6-sol

# Comma list advertised on /v1/models (defaults to PI_CLI_MODEL alone).
#PI_CODEX_CLI_MODELS=gpt-5.6-sol

# Where `codex exec` runs. Only matters for the read-only sandbox root; pi runs its own
# tools in YOUR cwd, so this is deliberately not your project directory.
#CODEX_BRIDGE_CWD=/Users/you

# read-only | workspace-write | danger-full-access. Keep read-only: pi owns the tool loop,
# so codex has no reason to touch the filesystem.
#CODEX_BRIDGE_SANDBOX=read-only

# 1 (default) passes --dangerously-bypass-hook-trust to `codex exec`. Codex apps/plugins —
# Atlassian Rovo, Slack, documents, and every MCP server you already have connected — are gated
# behind PERSISTED hook trust, granted interactively in the TUI. `codex exec` has no prompt, so
# with this off the whole apps layer silently vanishes and pi sees no connectors at all.
# It only skips the trust PROMPT for hooks YOU already enabled in ~/.codex/config.toml; the
# sandbox above still constrains what codex itself may touch. Set to 0 to opt out.
#CODEX_BRIDGE_BYPASS_HOOK_TRUST=1

# Seconds before a single `codex exec` turn is abandoned (504 to the client).
#CODEX_BRIDGE_TIMEOUT=600

# Concurrent codex runs. Each is a full CLI process, so keep this small.
#CODEX_BRIDGE_MAX_CONCURRENCY=2

# Explicit codex binary if it is not on PATH.
#CODEX_BIN=/opt/homebrew/bin/codex

# Optional bearer token required on /v1/chat/completions (loopback-only by default, so usually empty).
#CODEX_BRIDGE_API_KEY=
