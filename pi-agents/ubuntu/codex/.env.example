# codex backend (Ubuntu) — copy to .env next to run.sh and edit. install.sh and run.sh both read it.
# (run.sh reads .env too, but ONLY install.sh bakes these into the generated systemd runner —
#  after changing UPSTREAM_PORT you must re-run ./install.sh, not just restart the service.)

# Port the pure-LLM codex bridge listens on.
UPSTREAM_PORT=18288

# Model passed to `codex exec --model`. Must be one your codex login can use.
PI_CLI_MODEL=gpt-5.6-sol

# Comma list advertised on /v1/models. Leave unset: the bridge discovers every visible model
# from codex's own catalogue ($CODEX_HOME/models_cache.json).
#PI_CODEX_CLI_MODELS=gpt-5.6-sol,gpt-6-astra

# Where `codex exec` runs. Defaults to $XDG_DATA_HOME/pi-cli-codex/sandbox-root (an EMPTY dir).
# Keep it empty: it is the root of codex's read-only sandbox, and pi — not codex — reads your
# files. Pointing it at $HOME would let codex read ~/.ssh, .env files and its own auth.json.
#CODEX_BRIDGE_CWD=$HOME/.local/share/pi-cli-codex/sandbox-root

# read-only | workspace-write | danger-full-access. Keep read-only: pi owns the tool loop.
#CODEX_BRIDGE_SANDBOX=read-only

# 1 (default) passes --dangerously-bypass-hook-trust to `codex exec`. Codex apps/plugins —
# Atlassian, Slack, documents, and every MCP server you have connected — are gated behind
# PERSISTED hook trust, granted interactively in the TUI. `codex exec` has no prompt, so with
# this off the whole apps layer silently vanishes and pi sees no connectors at all. It only skips
# the trust PROMPT for hooks YOU already enabled in $CODEX_HOME/config.toml; the sandbox above
# still constrains codex. Set to 0 to opt out.
#CODEX_BRIDGE_BYPASS_HOOK_TRUST=1

# Seconds before a single `codex exec` turn is abandoned (504 to the client).
#CODEX_BRIDGE_TIMEOUT=600

# Concurrent codex runs. Each is a full CLI process, so keep this small.
#CODEX_BRIDGE_MAX_CONCURRENCY=2

# Explicit codex binary / config home if they are not in the usual place.
# CODEX_BIN matters more than it looks on Linux: the generated service runner starts PATH with
# the directory holding python3 — /usr/bin on most distros — so a leftover /usr/bin/codex from an
# older install shadows the npm-global one for the service while your shell keeps using the new
# one. Pin it if `curl :18288/config` reports a codex_bin you did not expect.
#CODEX_BIN=/usr/local/bin/codex
#CODEX_HOME=$HOME/.codex

# Optional bearer token required on /v1/chat/completions (loopback-only by default, so usually empty).
#CODEX_BRIDGE_API_KEY=
