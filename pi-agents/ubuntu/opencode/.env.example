# Environment variables read by the pi-agents extensions. Export them in your shell (or a
# direnv/.envrc) before running pi. Everything is optional; defaults shown.

# ── opencode-bridge-provider ─────────────────────────────────────────────────
# The OpenCode Bridge instance pi talks to. Use the PURE-LLM instance (started from
# opencode/pure-llm.json) so OpenCode does not run tools on its side too.
PI_UPSTREAM_BASE_URL=http://127.0.0.1:18385/v1
# Bearer token, only if that bridge was started with OPENCODE_BRIDGE_API_KEY.
PI_UPSTREAM_API_KEY=
# Comma-separated model ids to register instead of discovering from /v1/models.
PI_UPSTREAM_MODELS=

# ── guardrails (approvals) ────────────────────────────────────────────────────
# Policy overrides file (default: <pi-agents>/guardrails.json). "mode": ask | audit | enforce.
PI_GUARDRAILS_CONFIG=
# JSON-lines audit log of every tool decision (default: ~/.pi-bridge-audit.jsonl).
PI_GUARDRAILS_AUDIT=
# Headless runs (pi -p / --mode json) cannot show the approval prompt: deny (default) | allow.
PI_APPROVAL_NONINTERACTIVE=deny

# ── pi_bridge.py / run-bridge.sh (Hermes → pi) ────────────────────────────────
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=18484
UPSTREAM_PORT=18385                       # the pure-LLM OpenCode bridge run-bridge.sh starts for you
PI_BRIDGE_MODEL=opencode/mimo-v2.5-free
PI_BRIDGE_CWD=                            # fallback directory for pi's tools (default $HOME)
PI_BRIDGE_CWD_FROM_PROMPT=1               # follow the Hermes project ("Current working directory:" in its system prompt)
PI_BRIDGE_APPROVAL=ask                    # ask (reply "approve" in chat) | allow (POC: run all) | deny (read-only)
PI_BRIDGE_API_KEY=                        # bearer Hermes must send (empty = open, loopback only)
PI_BRIDGE_TOOLS=                          # e.g. read,bash,grep,find,ls ; empty = all pi built-ins
PI_BRIDGE_SYSTEM_PROMPT=                  # default prompts/sre.md ; "" disables
PI_BRIDGE_SHOW_TOOLS=1                    # "› bash mkdir x" notes in the reply
PI_BRIDGE_SHOW_OUTPUT=0               # quote the first N lines of each tool result under its line (0 = off)
PI_BRIDGE_TIMEOUT=600
PI_BRIDGE_KEEPALIVE=10                # seconds of silence before an SSE keepalive chunk (long tool runs)
PI_BRIDGE_MAX_CONCURRENCY=2
