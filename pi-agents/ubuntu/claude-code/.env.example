# Copy to .env (same folder) — run-bridge.sh and install.sh source it. All optional.

# ── ports ─────────────────────────────────────────────────────────────────────
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=18485                 # pi bridge (Hermes → http://127.0.0.1:18485/v1)
UPSTREAM_PORT=18186               # pure-LLM Claude Code bridge started by run-bridge.sh

# ── model (forwarded to `claude --model`) ─────────────────────────────────────
PI_BRIDGE_MODEL=claude-opus-5     # claude-fable-5-1 | claude-fable-5 | claude-sonnet-5 | claude-haiku-4-5 …
CLAUDE_CODE_BRIDGE_MODELS=claude-opus-5,claude-fable-5-1,claude-fable-5,claude-opus-4-8,claude-sonnet-5,claude-sonnet-4-6,claude-haiku-4-5
CLAUDE_CODE_EFFORT=medium         # default; Hermes' Min/Low/Med/High selector overrides per message (reasoning_effort)
CLAUDE_CODE_MAX_BUDGET_USD=       # per-turn spend cap for the claude CLI (empty = none)
CLAUDE_CODE_BRIDGE_TIMEOUT=600    # wall-clock cap per claude call (s)
# CLAUDE_BIN=/home/you/.local/bin/claude

# ── connectors (claude.ai MCP) ────────────────────────────────────────────────
PI_CLAUDE_NATIVE=1                # 1 = native tool calling via native/claude_native_bridge.py (default); 0 = legacy text emulation on mac/ bridge
PI_CLAUDE_CONNECTORS=1            # (legacy path only) 1 = built-ins off, read-only connectors on; 0 = strict `claude --tools ""`
PI_CLAUDE_WEB=1                   # 1 = Claude keeps WebSearch/WebFetch (pi has no web tool of its own); 0 = offline agent
CLAUDE_NATIVE_SESSION_IDLE=1800   # seconds before an idle warm claude session is reaped
CLAUDE_NATIVE_MAX_SESSIONS=8      # concurrent conversations kept warm
CLAUDE_CODE_MCP_ALLOW=            # override the read-only allowlist: comma-separated mcp__claude_ai_<Connector>__<tool> names

# ── claude.ai connectors (run inside Claude, read-only by default) ────────────
PI_CLAUDE_CONNECTORS=1            # 0 = strict pure-LLM mode (`claude --tools ""`, no connectors)
CLAUDE_CODE_MCP_ALLOW=            # comma-separated connector tool names to allow instead of the read-only Atlassian set
                                  # e.g. mcp__claude_ai_Atlassian__getJiraIssue,mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql

# ── pi bridge behaviour ───────────────────────────────────────────────────────
PI_BRIDGE_APPROVAL=ask            # ask (reply "approve" in chat) | allow (run all, logged) | deny (read-only)
PI_BRIDGE_CWD=                    # fallback dir for pi's tools (default $HOME); the Hermes project dir wins
PI_BRIDGE_CWD_FROM_PROMPT=1
PI_BRIDGE_API_KEY=                # bearer Hermes must send (empty = open, loopback only)
PI_BRIDGE_TOOLS=                  # e.g. read,bash,grep,find,ls ; empty = all pi built-ins
PI_BRIDGE_SYSTEM_PROMPT=          # default ../common/prompts/sre.md ; "" disables
PI_BRIDGE_SHOW_TOOLS=1
PI_BRIDGE_SHOW_OUTPUT=0               # quote the first N lines of each tool result under its line (0 = off)
PI_BRIDGE_TIMEOUT=600
PI_BRIDGE_KEEPALIVE=10                # seconds of silence before an SSE keepalive chunk (long tool runs)
PI_BRIDGE_MAX_CONCURRENCY=2

# ── guardrails ────────────────────────────────────────────────────────────────
PI_GUARDRAILS_CONFIG=             # default ./guardrails.json
PI_GUARDRAILS_AUDIT=              # default ~/.pi-bridge-audit.jsonl
