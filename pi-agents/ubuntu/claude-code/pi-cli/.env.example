# Copy to .env (same folder) — run.sh and install.sh source it. All optional.
UPSTREAM_PORT=18187                  # the pi-cli Claude Code bridge
PI_CLI_MODEL=claude-opus-5           # default model pi starts with (/model switches)
CLAUDE_CODE_BRIDGE_MODELS=claude-opus-5,claude-fable-5-1,claude-fable-5,claude-opus-4-8,claude-sonnet-5,claude-sonnet-4-6,claude-haiku-4-5
CLAUDE_CODE_EFFORT=medium            # default; `pi --thinking <level>` overrides per session
PI_CLAUDE_WEB=1                      # 1 = Claude keeps WebSearch/WebFetch (pi has no web tool); 0 = offline agent
CLAUDE_CODE_MAX_BUDGET_USD=          # per claude call (empty = none)
CLAUDE_CODE_BRIDGE_TIMEOUT=600
# CLAUDE_BIN=/home/you/.local/bin/claude
# PI_CLI_LOG=~/.pi-cli-claude-code.log
